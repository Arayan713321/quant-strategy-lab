{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "results/**", "use": "@vercel/static" },
    { "src": "charts/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/results/(.*)",
      "headers": { "cache-control": "s-maxage=0, no-cache, no-store, must-revalidate" },
      "dest": "/results/$1"
    },
    {
      "src": "/charts/(.*)",
      "headers": { "cache-control": "s-maxage=0, no-cache, no-store, must-revalidate" },
      "dest": "/charts/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
